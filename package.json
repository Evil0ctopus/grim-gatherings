{
  "name": "grim-gatherings",
  "private": true,
  "type": "module",
  "engines": { "node": ">=24.13.0" },
  "scripts": {
    "build:site": "node tools/build-site.mjs",
    "test:site": "node --test tests/build-site.mjs",
    "test:supabase": "node --test tests/supabase.mjs",
    "test:catalog-browser": "node tests/curated-catalog-e2e.mjs",
    "test:ui": "node tests/ui-refresh-e2e.mjs",
    "test:developer": "node --test tests/developer-games.mjs",
    "test:developer-browser": "node tests/developer-lab-e2e.mjs",
    "test:navigation": "node tests/host-navigation-e2e.mjs",
    "test:visitor": "node --test tests/host-wake-lock.mjs && node tests/visitor-review-e2e.mjs",
    "test:payments": "node --test tests/premium-payments.mjs",
    "test:payments-browser": "node tests/premium-browser.mjs",
    "test:premium-rooms": "node --test tests/premium-rooms.mjs",
    "test:premium-rooms-browser": "node tests/premium-rooms-browser.mjs",
    "check:edge": "deno check --allow-import supabase/functions/community/index.ts"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.8",
    "deno": "2.9.6",
    "playwright": "1.63.0"
  }
}
